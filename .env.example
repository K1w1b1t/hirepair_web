# Environment configuration for HirePair Local Development

# PostgreSQL Database
POSTGRES_DB=hirepair
POSTGRES_USER=hirepair
POSTGRES_PASSWORD=hirepair_secret
POSTGRES_PORT=5434
DATABASE_URL=postgresql://hirepair:hirepair_secret@localhost:5434/hirepair?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Web Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API Backend
PORT=3001
NODE_ENV=development
