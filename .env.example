# Configuração de ambiente do HirePair.
#
# Copie para `.env` na raiz do monorepo e ajuste o que precisar:
#
#     cp .env.example .env
#
# Gere GUEST_ACCESS_SECRET antes de iniciar a API. Os dados de infraestrutura funcionam com
# `npm run db:up` (Postgres + Redis via Docker). O `.env` é gitignored.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

# Credenciais consumidas pelo docker-compose.yml ao criar o container.
# Alterá-las depois do primeiro `db:up` NÃO reconfigura o volume já existente:
# rode `npm run db:down -- -v` antes, ou o Postgres continua com as antigas.
POSTGRES_DB=hirepair
POSTGRES_USER=hirepair
POSTGRES_PASSWORD=hirepair_secret
POSTGRES_PORT=5434

# Conexão usada pela API em runtime (Prisma Client).
# Local: o Postgres do docker-compose, exposto na 5434 para não colidir com um
# Postgres instalado na máquina.
DATABASE_URL=postgresql://hirepair:hirepair_secret@localhost:5434/hirepair?schema=public

# Conexão direta, usada SOMENTE por `prisma migrate` — deixe em branco no local.
#
# Só passa a importar no Supabase, onde as duas URLs são diferentes:
# o pooler em modo transaction (porta 6543) é o certo para a aplicação, mas não
# sustenta o advisory lock que a migration precisa. Sem DIRECT_URL, o Prisma cai
# para DATABASE_URL — o que é o comportamento correto localmente.
#
# As duas strings ficam em Supabase > Project Settings > Database >
# Connection string:
#   DATABASE_URL -> "Transaction pooler"  (porta 6543)
#   DIRECT_URL   -> "Session pooler"      (porta 5432)
# DIRECT_URL=

# Tamanho do pool de conexões do Prisma. Padrão 10 se ausente — o suficiente
# para o Free Tier do Supabase, que compartilha o pooler entre projetos.
# PRISMA_CONNECTION_LIMIT=10

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Produção (Upstash): URL TCP/TLS Node/ioredis. Cotas e throttle usam Lua atomicamente.
# Workers BullMQ ficam desligados enquanto não existir um job real.
# REDIS_URL=rediss://default:SUA_SENHA@SEU_ENDPOINT.upstash.io:6379

# Fallback local usado quando REDIS_URL não está definido.
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Frontend (apps/web)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostHog do navegador; sem token, fica desabilitado e so inicia apos consentimento.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_APP_ENV=development
# Segredos exclusivos do build para source maps; nunca sao publicos.
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=

# Search indexing is opt-in. Set true only in the Vercel Production environment;
# keep false for the release/staging branch so it stays public but unindexed.
SEARCH_INDEXING_ENABLED=false

# ---------------------------------------------------------------------------
# Backend (apps/api)
# ---------------------------------------------------------------------------

PORT=3001
NODE_ENV=development

# Origens CORS exatas como array JSON. O padrão local é ["http://localhost:3000"].
CORS_ORIGIN=["http://localhost:3000"]

# Swagger abre em /docs fora de produção; em produção, habilite explicitamente.
API_DOCS_ENABLED=false

# Telemetria operacional anonima da API; opcional e independente do consentimento.
# POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENVIRONMENT=development

# Opcional: alertas deduplicados de HTTP 500 e falhas finais de jobs.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---------------------------------------------------------------------------
# IA — análise profissional limitada; desabilitada até validar o ambiente
# ---------------------------------------------------------------------------
APP_ENV=development
# Obrigatório mesmo com IA desligada. Gere um valor por ambiente:
# openssl rand -hex 32
GUEST_ACCESS_SECRET=
AI_PUBLIC_ENABLED=false
# Alias não secreto da organização Groq. Ambientes da mesma organização DEVEM
# compartilhar este alias e o mesmo Redis para contabilizar a cota conjunta.
AI_QUOTA_POOL=local
# GROQ_API_KEY=
GROQ_ZDR_CONFIRMED=false
GROQ_FREE_TIER_CONFIRMED=false
# Preencha somente após confirmar ZDR e os limites gratuitos no console Groq.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# Modelos fixos no servidor: GPT-OSS 120B; fallback 20B só em rede/5xx.
# Gemini gratuito não recebe material real; não integra esta cadeia.
