# Copie este arquivo para demo/.env e preencha a chave.
# Gere a chave em https://aistudio.google.com/apikey (login com conta Google → Create API key).
GEMINI_API_KEY=

# Opcionais: chaves reserva. Quando a cota da principal acaba no meio da sessão, o
# script mostra estas como opção de troca — sem perder nada do que já foi coletado.
# A cota gratuita é por conta Google, então reserva só ajuda se for de OUTRA conta.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Opcional. Modelo usado nas chamadas; troque se este deixar de existir.
GEMINI_MODEL=gemini-3.6-flash
