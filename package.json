{
  "name": "hirepair_web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky || true",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:deploy": "npm run db:deploy -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "prebuild": "npm run build -w @hirepair/interview-engine",
    "pretest": "npm run build -w @hirepair/interview-engine",
    "pretypecheck": "npm run build -w @hirepair/interview-engine"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml,css,js,mjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "overrides": {
    "@isaacs/brace-expansion": "^5.0.1",
    "axios": "^1.21.0",
    "form-data": "^4.0.6",
    "follow-redirects": "^1.16.2",
    "minimatch@>=10 <10.2.3": "^10.2.6",
    "multer": "^2.5.0",
    "js-yaml@>=5 <5.5.0": "^5.5.0",
    "postcss": "^8.5.32"
  }
}
